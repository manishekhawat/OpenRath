<?xml version="1.0" encoding="utf-8"?>
<!-- The USB devices Android offers OpenRath's Android Auto for (AaUsbStart in the manifest, on only
     while the androidAuto switch is). The same kinds AaUsb.looksLikePhone accepts, after
     Headunit Revived's usb_device_filter.xml (AGPL-3.0): a phone already in accessory mode, and a
     phone's ADB, picture transfer, tethering and file-transfer interfaces. -->
<resources>
    <usb-device vendor-id="6353" product-id="11520" />
    <usb-device vendor-id="6353" product-id="11521" />
    <usb-device class="255" subclass="255" protocol="0" />
    <usb-device class="255" subclass="66" protocol="1" />
    <usb-device class="6" subclass="1" protocol="1" />
    <usb-device class="224" subclass="1" protocol="3" />
</resources>
